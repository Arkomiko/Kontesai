# Copy to .env and fill in. Never commit .env.

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=

# Database
POSTGRES_USER=kontesai
POSTGRES_PASSWORD=
POSTGRES_DB=kontesai
DATABASE_URL=postgresql://kontesai:<password>@localhost:5432/kontesai

# Twitch OAuth (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback

# Telegram Login Widget (bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# VK ID (https://id.vk.com/about/business)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:4000/auth/vk/callback
